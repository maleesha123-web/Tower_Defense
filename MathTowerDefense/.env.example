# ---------------------------------------------------------------------------
# Math Tower Defense 2D - example configuration
# Copy the values you need into your environment (or Eclipse run configuration:
# Run As -> Run Configurations -> Environment). NEVER put real secrets in source
# code.
# ---------------------------------------------------------------------------

# The OFFICIAL Fish Game API documentation (https://marcconrad.com/uob/fish/doc.php)
# does NOT define any API key or authentication. This variable is therefore
# OPTIONAL and is NOT sent with requests - it only exists so a key can be
# configured centrally if the API ever requires one.
FISH_API_KEY=YOUR_API_KEY_HERE

# MongoDB Connection (MongoDB Compass / local instance).
# Default URL: mongodb://localhost:27017
# Database: mathtowerdefense
MTD_DB_URL=mongodb://localhost:27017
MTD_DB_NAME=mathtowerdefense
